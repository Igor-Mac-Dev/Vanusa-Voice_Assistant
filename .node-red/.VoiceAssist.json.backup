  {
    "id": "29eec978bf1da92e",
    "type": "function",
    "z": "60125a0ab74411c0",
    "name": "Cancel Filter",
    "func": "//  You dont need to change this node, just pipe your chain\n// of nodes here so Vanusa can go back to idle mode\n// This node is to set the flow's var CANCEL to TRUE, you\n// can use this in your nodes with const cancel = flow.get(\"CANCEL\")\n// and abort some action. DON'T manualy set it to FALSE,\n// it will be done when your message arrives this node.\nif(msg.payload == 'cancel'){\n    flow.set(\"CANCEL\", true)\n    return [{payload: 'canceled'},null];\n}\nif(flow.get('CANCEL')){\n    flow.set('CANCEL', false)\n    return [null, msg]\n} else {\n    return [ msg , null]\n}\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 4390,
    "y": 200,
    "wires": [
      [
        "897da9b390c11c60"
      ],
      [
        "314c9dc8fc01913d"
      ]
    ]
  },
  {
    "id": "6fec0ada93180f5c",
    "type": "inject",
