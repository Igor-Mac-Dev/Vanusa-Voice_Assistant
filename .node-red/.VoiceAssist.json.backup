        "3ad208dd7ae27c61"
      ]
    ]
  },
  {
    "id": "3ad208dd7ae27c61",
    "type": "function",
    "z": "60125a0ab74411c0",
    "name": "ENV_VARS",
    "func": "//You can set your vars here if u want\nflow.set('CANCEL', false)\nmsg.payload=\"Flow variables set.\"\nreturn msg;",
