  {
    "id": "1c86ddab9acb49a8",
    "type": "comment",
    "z": "60125a0ab74411c0",
    "name": "✅TIPS✅",
    "info": "From here on your command is an object, it's\npayload is the intent of the command and\nthe slots are in the order you've set. Pipe a\ndebug node here if you still want to check.\nOpen this switch node, set or create an \noutput based on your command intent, then\ncreate his flow. Please don't forget to pipe\nit to the Cancel Filter node or the voice\nassistant will keep wating for a confirmation\nthat the cmd was executed. You can bypass \nthis just speaking 'cancel' and Vanusa \nwill come back to idle mode, but is better\nto avoid this scenario.\nIf the message passed to Cancel Filter\nhas a cmd_response field, Vanusa will speak\nit instad of just playing an sucess beep\n",
    "x": 680,
    "y": 380,
    "wires": []
  },
  {
    "id": "21074d7f7b687076",
    "type": "function",
    "z": "60125a0ab74411c0",
    "name": "CMD formatter",
    "func": "if(msg.payload == '*ping*' || msg.payload == 'cancel') {\n    return msg;\n} else {\n    return msg;\n}",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
