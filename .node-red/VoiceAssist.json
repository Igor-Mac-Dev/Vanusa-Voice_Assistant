  {
    "id": "29eec978bf1da92e",
    "type": "function",
    "z": "60125a0ab74411c0",
    "name": "Cancel Filter",
    "func": "//  You dont need to change this node, just pipe your chain\n// of nodes here so Vanusa can go back to idle mode\n//  To make yor voice commands also cancelable in node red\n// and not only cancel the voice output in the main app the\n// 'CANCEL' environment var need to be correctly handled,\n// and pipe nodes NOT activated by Vanusa here will mess\n// with both node red and Vanusa!\n// This node is to set the flow's var CANCEL to TRUE, you\n// can use this in your nodes with:\n// const cancel = flow.get(\"CANCEL\")\n// and abort some action. DON'T manualy set it to FALSE,\n// it will be done when your message arrives this node.\n// You can also make Vanusa say something by piping cron\n// activated nodes (and this sort of things) directly to the\n// node 'send to Vanusa' web-socket-out node in the top right\n// of this node (above the 🚫's) or the PIPE bellow\n\nif(msg.payload == 'cancel'){\n    flow.set(\"CANCEL\", true)\n    return [{payload: 'canceled'},null];\n}\nif(flow.get('CANCEL')){\n    flow.set('CANCEL', false)\n    return [null, msg]\n} else {\n    return [ msg , null]\n}\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 4390,
    "y": 160,
    "wires": [
      [
        "897da9b390c11c60"
      ],
      [
        "314c9dc8fc01913d"
      ]
    ]
  },
