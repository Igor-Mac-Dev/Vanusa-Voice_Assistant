        "func": "const newPort = msg.payload; // Porta nova lida do RED-port.txt\n\n// Obter configuração dos fluxos\nconst optionsGet = {\n    url: 'http://localhost:1880/flows',\n    method: 'GET',\n    headers: { 'Content-Type': 'application/json' }\n};\n\nnode.send({ payload: newPort, portUpdate: true });\n\nreturn optionsGet;\n",
